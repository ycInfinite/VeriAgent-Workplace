{
  "modelProviders": {
    "openai": [
      {
        "id": "qwen3.8-max",
        "name": "VeriAgent interactive Token Plan",
        "baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
        "envKey": "BAILIAN_TOKEN_PLAN_API_KEY",
        "generationConfig": {
          "contextWindowSize": 8192,
          "maxRetries": 0,
          "samplingParams": {
            "max_tokens": 256,
            "temperature": 0.2
          },
          "extra_body": {
            "enable_thinking": false
          }
        }
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "qwen3.8-max"
  },
  "telemetry": {
    "enabled": false,
    "logPrompts": false
  },
  "mcpServers": {
    "workplace": {
      "command": "/root/autodl-tmp/veriagent-workplace-sft-20260910/.venv/bin/python",
      "args": [
        "/root/autodl-tmp/veriagent-workplace-sft-20260910/scripts/serve_workplace_interactive.py",
        "--task-id",
        "707"
      ],
      "cwd": "/root/autodl-tmp/veriagent-workplace-sft-20260910",
      "trust": false,
      "timeout": 60000,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "BAILIAN_TOKEN_PLAN_API_KEY": "",
        "OPENAI_API_KEY": ""
      }
    }
  },
  "$version": 4,
  "permissions": {
    "allow": [
      "mcp__workplace__get_task",
      "mcp__workplace__execute_workplace_tool",
      "mcp__workplace__finish_task"
    ]
  }
}